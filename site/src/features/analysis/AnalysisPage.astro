---
// The long-form analysis, rendered in Spanish at /analisis and in English at
// /en/analysis. All copy comes from the dictionaries (i18n/), all figures from
// the repository data files, read at build time (lib/analysis-data.js).
import { fileURLToPath, pathToFileURL } from 'node:url';
import Base from '../../layouts/Base.astro';
import SideNav from '../../components/SideNav.astro';
import Hero from '../../components/Hero.astro';
import Chapter from '../../components/Chapter.astro';
import BigNum from '../../components/BigNum.astro';
import Note from '../../components/Note.astro';
import Quote from '../../components/Quote.astro';
import Tagline from '../../components/Tagline.astro';
import Steps from '../../components/Steps.astro';
import Checks from '../../components/Checks.astro';
import Glossary from '../../components/Glossary.astro';
import ChartFigure from '../../components/ChartFigure.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { dictionaries, renderDictionary } from '../../i18n/index.js';
import { loadAnalysisData } from '../../lib/analysis-data.js';
import { AUTHOR_URL, PRESS_URL, REPO_URL, auditDocUrl, explorerTokenUrl, shortAddress } from '../../lib/links.js';
import { buildVars } from './vars.js';

import polygonMonthly from '../../../../charts/polygon/site/04-monthly-volume-usd.svg?raw';
import celoMonthly from '../../../../charts/celo/site/04-monthly-volume-usd.svg?raw';
import transfersByChain from '../../../../charts/combined/site/02-monthly-transfers-by-chain.svg?raw';
import cumulativeByChain from '../../../../charts/combined/site/03-cumulative-volume-by-chain.svg?raw';

interface Props {
  lang: 'es' | 'en';
  /** Route-table key of the page that renders this component. */
  page?: 'dashboard' | 'analysis';
}

const { lang, page = 'analysis' } = Astro.props;

// `astro build` runs from site/; the data lives one level up.
const dataDir = fileURLToPath(new URL('../data', pathToFileURL(`${process.cwd()}/`)));
const data = loadAnalysisData({ dataDir });
const vars = buildVars(data, lang);
const t = renderDictionary(dictionaries[lang], vars);
const { chapters: ch } = t;
const { polygon, celo } = data.chains;

const chapterIds = ['problema', 'copm', 'metodo', 'polygon', 'celo', 'duo', 'confianza', 'prensa', 'glosario'];
const chapterNums = ['01', '02', '03', '04', '05', '06', '07', '08', 'A'];
const navItems = chapterIds.map((id, index) => ({ href: `#${id}`, num: chapterNums[index], text: ch[id].nav }));

const footerLinks = [
  { href: REPO_URL, text: t.footer.links.repo },
  { href: auditDocUrl(lang), text: t.footer.links.audit },
  { href: explorerTokenUrl('polygon', polygon.address), text: t.footer.links.polygon },
  { href: explorerTokenUrl('celo', celo.address), text: t.footer.links.celo },
  { href: PRESS_URL, text: t.footer.links.press },
  { href: AUTHOR_URL, text: t.footer.links.github },
];

const explorerLinks = [polygon, celo].map((c) => ({
  href: explorerTokenUrl(c.key, c.address),
  text: shortAddress(c.address),
}));
---

<Base lang={lang} page={page} title={t.meta.title} description={t.meta.description}>
  <!-- Reveals are an enhancement: the class is set before first paint, and only
       when the visitor has not asked for reduced motion. -->
  <script is:inline slot="head">
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-reveal');
  </script>
  <div id="progress" slot="before-header" role="presentation"></div>
  <SideNav label={t.a11y.chaptersLabel} items={navItems} />

  <Hero eyebrow={t.hero.eyebrow} stats={t.hero.stats} scrollHint={t.hero.scrollHint}>
    <Fragment slot="title">{t.hero.titleLine1}<br />{t.hero.titleLine2}<br /><span class="big">{t.hero.titleBig}</span></Fragment>
    <Fragment slot="sub">{t.hero.sub}</Fragment>
  </Hero>

  <main id="main">
    <Chapter id="problema" label={ch.problema.label}>
      <Fragment slot="title">{ch.problema.title}</Fragment>
      <p class="lead" set:html={ch.problema.lead} />
      <p>{ch.problema.p1}</p>
      <p>{ch.problema.p2}</p>
      <p set:html={ch.problema.p3} />
      <p>{ch.problema.p4}</p>
    </Chapter>

    <Chapter id="copm" label={ch.copm.label}>
      <Fragment slot="title">{ch.copm.title}</Fragment>
      <p set:html={ch.copm.p1} />
      <p>{ch.copm.p2}</p>
      <div class="duo">
        <article class="card mint">
          <h4>{ch.copm.mint.title}</h4>
          <p class="small flush" set:html={ch.copm.mint.body} />
        </article>
        <article class="card burn">
          <h4>{ch.copm.burn.title}</h4>
          <p class="small flush" set:html={ch.copm.burn.body} />
        </article>
      </div>
      <p set:html={ch.copm.p3} />
      <p set:html={ch.copm.p4} />
    </Chapter>

    <Chapter id="metodo" label={ch.metodo.label}>
      <Fragment slot="title">{ch.metodo.title}</Fragment>
      <p>{ch.metodo.intro}</p>
      <Steps steps={ch.metodo.steps} />
    </Chapter>

    <Tagline text={t.tagline.text} />

    <Chapter id="polygon" label={ch.polygon.label}>
      <Fragment slot="title" set:html={ch.polygon.title} />
      <p class="lead">{ch.polygon.lead}</p>
      <BigNum value={vars.polygonGrossUsdShort} variant="p" desc={ch.polygon.bigNum} />
      <p>{ch.polygon.intro}</p>
      <p set:html={ch.polygon.act1} />
      <p set:html={ch.polygon.act2} />
      <p set:html={ch.polygon.act3} />
      <ChartFigure svg={polygonMonthly} caption={ch.polygon.chartCaption} />
      <Note variant="polygon"><Fragment set:html={ch.polygon.note} /></Note>
    </Chapter>

    <Chapter id="celo" label={ch.celo.label}>
      <Fragment slot="title" set:html={ch.celo.title} />
      <p class="lead">{ch.celo.lead}</p>
      <BigNum value={vars.celoTicket} variant="c" desc={ch.celo.bigNum} />
      <p set:html={ch.celo.p1} />
      <p set:html={ch.celo.p2} />
      <ChartFigure svg={celoMonthly} caption={ch.celo.chartCaption} />
      <Note variant="celo"><Fragment set:html={ch.celo.note} /></Note>
    </Chapter>

    <Chapter id="duo" label={ch.duo.label}>
      <Fragment slot="title">{ch.duo.title}</Fragment>
      <p class="lead">{ch.duo.lead}</p>
      <ChartFigure svg={transfersByChain} caption={ch.duo.transfersCaption} />
      <p set:html={ch.duo.relay} />
      <div class="table-scroll" role="region" aria-label={ch.duo.title} tabindex="0">
        <table class="tbl">
          <thead><tr><th scope="col">{ch.duo.table.metric}</th><th scope="col">{ch.duo.table.polygon}</th><th scope="col">{ch.duo.table.celo}</th></tr></thead>
          <tbody>
            {ch.duo.table.rows.slice(0, 1).map((row) => (
              <tr><th scope="row">{row.label}</th><td class="mono">{row.polygon}</td><td class="mono">{row.celo}</td></tr>
            ))}
            <tr>
              <th scope="row">{ch.duo.table.explorer}</th>
              {explorerLinks.map((link) => (
                <td class="mono"><a href={link.href} target="_blank" rel="noopener noreferrer">{link.text} ↗</a></td>
              ))}
            </tr>
            {ch.duo.table.rows.slice(1).map((row) => (
              <tr><th scope="row" set:html={row.label} /><td class="mono">{row.polygon}</td><td class="mono">{row.celo}</td></tr>
            ))}
            <tr class="hl"><th scope="row">{ch.duo.table.combined}</th><td class="mono center" colspan="2"><strong>{ch.duo.table.combinedValue}</strong></td></tr>
          </tbody>
        </table>
      </div>
      <ChartFigure svg={cumulativeByChain} caption={ch.duo.cumulativeCaption} />
    </Chapter>

    <Chapter id="confianza" label={ch.confianza.label}>
      <Fragment slot="title">{ch.confianza.title}</Fragment>
      <p>{ch.confianza.intro}</p>
      <Checks items={ch.confianza.checks} />
      <pre class="repro" tabindex="0"><code><span class="c">{ch.confianza.reproComment}</span>
git clone {REPO_URL}.git
cd copm-onchain-analysis && cp .env.example .env
npm install && npm run audit:all</code></pre>
      <p class="muted small">{ch.confianza.more}</p>
    </Chapter>

    <Chapter id="prensa" label={ch.prensa.label}>
      <Fragment slot="title">{ch.prensa.title}</Fragment>
      <Quote>
        {ch.prensa.quote}
        <Fragment slot="cite">— <cite><a href={PRESS_URL} target="_blank" rel="noopener noreferrer">{ch.prensa.cite}</a></cite> {ch.prensa.citeNote}</Fragment>
      </Quote>
      <p set:html={ch.prensa.p1} />
      <p>{ch.prensa.p2}</p>
    </Chapter>

    <Chapter id="glosario" label={ch.glosario.label}>
      <Fragment slot="title">{ch.glosario.title}</Fragment>
      <Glossary items={ch.glosario.items} />
    </Chapter>
  </main>

  <SiteFooter navLabel={t.a11y.linksLabel} links={footerLinks} credit={t.footer.credit} />
</Base>

<script>
  // Everything below is an enhancement of the analysis page: the content is
  // readable without it, and nothing moves for visitors who ask for less motion.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reading progress, throttled through requestAnimationFrame.
  const bar = document.getElementById('progress');
  let frame = 0;
  function paint() {
    frame = 0;
    if (!bar) return;
    const root = document.documentElement;
    const max = root.scrollHeight - root.clientHeight;
    bar.style.transform = `scaleX(${max > 0 ? root.scrollTop / max : 0})`;
  }
  addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(paint); }, { passive: true });
  paint();

  if (!reduced) {
    // Chapters rise and sharpen as they enter the viewport.
    const reveal = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('visible');
          reveal.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

    // Tagline: each word lights up, in reading order, as it crosses a trigger
    // line 40% above the bottom of the viewport; scrolling back dims it again.
    const words = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const below = entry.boundingClientRect.top > (entry.rootBounds?.bottom ?? 0);
          // Inside the lit zone or already scrolled past: lit. Still below the line: dim.
          entry.target.classList.toggle('lit', entry.isIntersecting || !below);
        });
      },
      { rootMargin: '0px 0px -40% 0px' }
    );
    document.querySelectorAll('.tagline .w').forEach((el) => words.observe(el));
  }
</script>
