---
// The dashboard, rendered in Spanish at / and in English at /en/. Everything
// that is a figure, a card or a table is rendered here, on the server, from the
// data the pipeline wrote (data/<chain>/dashboard.json); the charts are drawn
// in the browser (charts.js) from one JSON payload embedded in the page.
// Prose is kept out of the page: findings are cards, notes and tables sit in
// disclosures that carry their key figure in the summary line.
import { fileURLToPath, pathToFileURL } from 'node:url';
import Base from '../../layouts/Base.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ChartBlock from './ChartBlock.astro';
import LargestTable from './LargestTable.astro';
import StatCards from './StatCards.astro';
import StatusIcon from './StatusIcon.astro';
import '../../styles/dashboard.css';
import { dashboardDictionaries } from '../../i18n/index.js';
import { interpolate } from '../../lib/template.js';
import { routePath } from '../../lib/routes.js';
import { clientPayload, loadDashboardData } from '../../lib/dashboard-data.js';
import { headlineCards } from '../../lib/dashboard-cards.js';
import { CHAIN_CHOICES, DEFAULT_STATE, PERIOD_CHOICES, UNIT_CHOICES } from '../../lib/dashboard-filters.js';
import { PERIOD_DAYS, flowStats, granularityFor, largestRows, tilesFor } from '../../lib/dashboard-view.js';
import { amountCompact, amountFull, arrowFor, changeText, eventArgText, shortDate, tileNotes, utcDateTime } from '../../lib/dashboard-format.js';
import { formatDate, formatDecimal, formatInt, formatMonthShort, rangeLabels } from '../../lib/format.js';
import { formatSerialBlock } from '../../lib/serial.js';
import {
  REPO_URL,
  eventsDocUrl,
  explorerAddressUrl,
  explorerTxUrl,
  holdersCsvUrl,
  middleEllipsis,
  readmeUrl,
} from '../../lib/links.js';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = dashboardDictionaries[lang];

// `astro build` runs from site/; the data lives one level up.
const dataDir = fileURLToPath(new URL('../data', pathToFileURL(`${process.cwd()}/`)));
const data = loadDashboardData({ dataDir });
const payload = clientPayload(data);
const keys = Object.keys(data.chains);
const chainLabel = (key: string) => data.chains[key].label;
const chainLabels = Object.fromEntries(keys.map((k) => [k, chainLabel(k)]));

const state = DEFAULT_STATE;
const granularity = granularityFor(state.period);
const resolveBucket = (template: string) => interpolate(template, { bucket: t.charts.bucket[granularity] });
const periodLabel = (choice: string) => {
  const days = PERIOD_DAYS[choice as keyof typeof PERIOD_DAYS];
  if (choice === '30d') return interpolate(t.filters.period.d30, { n: days });
  if (choice === '90d') return interpolate(t.filters.period.d90, { n: days });
  return choice === '1y' ? t.filters.period.y1 : t.filters.period.all;
};
const pct = (n: number, digits = 1) => `${formatDecimal(n, digits, lang)}${lang === 'es' ? ' %' : '%'}`;

// The headline cards and the first view of the tiles, by the same functions
// the browser uses when a filter changes.
const cards = headlineCards({ chains: payload.chains, chain: state.chain, t: t.cards, lang });
const tiles = tilesFor(payload.chains, state);
const deltaText = (change: number | null, key: 'vsPeriod' | 'vsStart') => {
  const text = changeText(change, lang);
  if (text === null) return t.tiles.noBase;
  return `${arrowFor(change)} ${interpolate(t.tiles[key], { change: text, n: tiles.window.days ?? '' })}`;
};
const serial = tiles.blocks.map((b) => `${b.chain === 'polygon' ? 'POL' : 'CELO'} ${formatSerialBlock(b.block)}`).join(' · ');
const latestTime = Math.max(...tiles.blocks.map((b) => b.time));
const notes = tileNotes({ tiles, t, lang });
const tileList = [
  { id: 'supply', k: t.tiles.supply.k, v: amountCompact(tiles.supply.value, state.unit, lang), d: deltaText(tiles.supply.changePct, 'vsStart'), n: notes.supply },
  { id: 'volume', k: t.tiles.volume.k, v: amountCompact(tiles.volume.current, state.unit, lang), d: deltaText(tiles.volume.changePct, 'vsPeriod'), n: notes.volume },
  { id: 'transfers', k: t.tiles.transfers.k, v: formatInt(tiles.transfers.current, lang), d: deltaText(tiles.transfers.changePct, 'vsPeriod'), n: notes.transfers },
  { id: 'holders', k: t.tiles.holders.k, v: formatInt(tiles.holders, lang), d: '', n: notes.holders },
  { id: 'block', k: t.tiles.block.k, v: serial, d: utcDateTime(latestTime), n: notes.block },
];

// How the gross volume splits, with the turnover as its headline figure.
const flows = flowStats(payload.chains, state);
const times = (n: number) => `${formatDecimal(n, 1, lang)}×`;

// Stat cards of the sections: whole-history figures per chain.
const dash = (k: string) => data.chains[k].dashboard;
const countOf = (events: any[], name: string) => events.filter((e) => e.name === name).length;
const supplyStats = keys.flatMap((k) => {
  const d = dash(k);
  return [
    { chain: k, label: t.stats.minted, figure: amountCompact(d.flows.minted, 'copm', lang), support: amountCompact(d.flows.usd.minted, 'usd', lang) },
    { chain: k, label: t.stats.burned, figure: amountCompact(d.flows.burned, 'copm', lang), support: amountCompact(d.flows.usd.burned, 'usd', lang) },
    ...(d.supplyPeak
      ? [{ chain: k, label: t.stats.peak, figure: amountCompact(d.supplyPeak.copm, 'copm', lang), support: shortDate(d.supplyPeak.day, lang) }]
      : []),
  ];
});
const whoStats = keys.flatMap((k) => {
  const h = dash(k).holders;
  return [
    { chain: k, label: t.stats.top1, figure: pct(h.top1Pct), support: interpolate(t.stats.top1Support, { top10: pct(h.top10Pct) }) },
    { chain: k, label: t.stats.holders, figure: formatInt(h.count, lang), support: interpolate(t.stats.holdersSupport, { contracts: formatInt(h.contracts, lang), below1: formatInt(h.below1, lang) }) },
  ];
});
const controlStats = keys.flatMap((k) => {
  const g = dash(k).governance;
  const day = shortDate(new Date(dash(k).checkpoint.time * 1000).toISOString().slice(0, 10), lang);
  const pauses = countOf(g.events, 'Paused');
  const upgrades = g.events.filter((e: any) => e.name === 'Upgraded').slice(1);
  return [
    { chain: k, label: t.stats.roles, figure: formatInt(g.roleHolders, lang), support: interpolate(t.stats.rolesSupport, { count: formatInt(Object.values(g.roles as Record<string, string[]>).filter((m) => m.length > 0).length, lang) }) },
    { chain: k, label: t.stats.state, figure: g.paused ? t.stats.paused : t.stats.active, support: pauses === 0 ? t.stats.pausesNone : interpolate(t.stats.pauses, { count: formatInt(pauses, lang) }) },
    { chain: k, label: t.stats.frozen, figure: formatInt(g.frozen.length, lang), support: interpolate(t.stats.asOf, { date: day }), addresses: g.frozen },
    { chain: k, label: t.stats.upgrades, figure: formatInt(upgrades.length, lang), support: upgrades.length ? interpolate(t.stats.upgradesLast, { date: shortDate(upgrades.at(-1).day, lang) }) : t.stats.upgradesNone },
  ];
});

// The one line about the dollar rate, always in the HTML.
const lastDay = keys.map((k) => dash(k).activity.endDay).sort().at(-1);

// Tables the no-JavaScript reader gets for the charts that do not depend on a
// period: transfer sizes and the top holders.
const sizeLabels = rangeLabels(dash(keys[0]).sizes.map((s: any) => s.min), lang);
const sizeRows = sizeLabels.map((label: string, k: number) => ({
  label,
  counts: keys.map((key) => formatInt(dash(key).sizes[k].count, lang)),
}));
const topRows = keys.flatMap((key) => dash(key).holders.top.slice(0, 10).map((h: any) => ({ chain: key, ...h })));

// Monthly figures, for the no-JavaScript reader and for anyone who wants them.
const monthlyRows = keys.flatMap((key) => {
  const m = dash(key).monthly;
  return m.month.map((month: string, i: number) => ({
    chain: key,
    month: formatMonthShort(month, lang),
    supply: amountCompact(m.supply[i], 'copm', lang),
    minted: amountCompact(m.mint[i], 'copm', lang),
    burned: amountCompact(m.burn[i], 'copm', lang),
    transfers: formatInt(m.transfers[i], lang),
    gross: amountCompact(m.volume[i], 'copm', lang),
  }));
});
const allMonths = keys.flatMap((k) => dash(k).monthly.month).sort();

const largest = largestRows(payload.chains, state);
const LARGEST_VISIBLE = 5;
const holderBuckets = keys.map((k) => {
  const buckets = dash(k).holders.buckets;
  const labels = rangeLabels(buckets.map((b: any) => b.min), lang);
  return { key: k, buckets: buckets.map((b: any, i: number) => ({ ...b, label: labels[i] })), total: dash(k).checkpoint.totalSupply };
});
const roleEntries = (k: string): [string, string[]][] => Object.entries(dash(k).governance.roles);
const meaningOf = (name: string) => (t.control.eventMeaning as Record<string, string>)[name] ?? t.control.eventMeaning.other;
const roleMeaningOf = (role: string) => (t.control.roleMeaning as Record<string, string>)[role] ?? '';
const ruleLabelOf = (id: string) => (t.trust.ruleLabel as Record<string, string>)[id] ?? id;
const isAddress = (value: unknown): value is string => typeof value === 'string' && /^0x[0-9a-fA-F]{40}$/.test(value);

const footerLinks = [
  { href: REPO_URL, text: t.footer.repo },
  { href: routePath('analysis', lang), text: t.footer.analysis },
  { href: eventsDocUrl(lang), text: t.footer.events },
];

// Only what the browser needs to draw, re-filter and re-label.
const clientText = {
  lang,
  cards: t.cards,
  tiles: t.tiles,
  filters: { window: t.filters.window },
  charts: t.charts,
  legend: t.legend,
  chartUi: t.chartUi,
  columns: t.columns,
  who: { largestEmpty: t.who.largestEmpty, largestMore: t.who.largestMore },
  names: { polygon: chainLabel('polygon'), celo: chainLabel('celo') },
  bucket: t.charts.bucket,
};
const clientData = { ...payload, t: clientText };
---

<Base lang={lang} page="dashboard" title={t.meta.title} description={t.meta.description}>
  <main id="main" class="dash" data-dashboard data-lang={lang}>
    <section class="dash-head" aria-labelledby="dash-title">
      <p class="dash-eyebrow">{t.header.eyebrow}</p>
      <h1 id="dash-title">{t.header.title}</h1>
      <p class="dash-lead">{t.header.lead} <a href={routePath('analysis', lang)}>{t.header.analysis} →</a></p>
      <noscript><p class="note-inline">{t.header.noscript}</p></noscript>
    </section>

    <ul class="cards" data-cards aria-label={t.cards.label}>
      {cards.map((card) => (
        <li class="hcard" data-card={card.id}>
          <p class="v">{card.figure}</p>
          <p class="k">{card.label}</p>
          <p class="d">{card.support}</p>
        </li>
      ))}
    </ul>

    <p class="dash-basis" data-basis>{interpolate(t.basis.rate, { rate: formatDecimal(data.fx.latest, 2, lang, { trim: true }), date: formatDate(data.fx.latestDay, lang) })}</p>

    <form class="filters" data-filters hidden aria-label={t.filters.label} onsubmit="return false">
      <div class="filter" role="group" aria-label={t.filters.chain.label} data-filter="chain">
        <span class="filter-k">{t.filters.chain.label}</span>
        {CHAIN_CHOICES.map((c) => (
          <button type="button" class="seg" data-value={c} aria-pressed={c === state.chain ? 'true' : 'false'}>
            {t.filters.chain[c as 'both']}
          </button>
        ))}
      </div>
      <div class="filter" role="group" aria-label={t.filters.period.label} data-filter="period">
        <span class="filter-k">{t.filters.period.label}</span>
        {PERIOD_CHOICES.map((p) => (
          <button type="button" class="seg" data-value={p} aria-pressed={p === state.period ? 'true' : 'false'}>
            {periodLabel(p)}
          </button>
        ))}
      </div>
      <div class="filter" role="group" aria-label={t.filters.unit.label} data-filter="unit">
        <span class="filter-k">{t.filters.unit.label}</span>
        {UNIT_CHOICES.map((u) => (
          <button type="button" class="seg" data-value={u} aria-pressed={u === state.unit ? 'true' : 'false'}>
            {t.filters.unit[u as 'copm']}
          </button>
        ))}
      </div>
      <p class="filter-note"><span>{t.filters.scope}</span> <span data-window>{interpolate(t.filters.window, { from: formatDate(tiles.window.fromDay, lang), to: formatDate(tiles.window.toDay, lang) })}</span></p>
    </form>

    <ul class="cardgrid dtiles" aria-label={t.header.eyebrow}>
      {tileList.map((tile) => (
        <li class="dtile" data-tile={tile.id}>
          <p class="v" data-v>{tile.v}</p>
          <p class="k">{tile.k}</p>
          <p class="d" data-d>{tile.d}</p>
          <p class="n" data-n hidden={!tile.n}>{tile.n}</p>
        </li>
      ))}
    </ul>

    <details class="disclosure notes">
      <summary>{interpolate(t.notes.summary, { day: formatDate(lastDay, lang) })}</summary>
      <div class="disclosure-body">
        <p>{t.notes.complete}</p>
        <ul>
          {keys.map((k) => (
            <li>{interpolate(t.notes.item, { chain: chainLabel(k), day: formatDate(dash(k).activity.endDay, lang), block: formatInt(dash(k).checkpoint.block, lang), time: utcDateTime(dash(k).checkpoint.time) })}</li>
          ))}
        </ul>
        <p>{t.notes.method}</p>
        <p><a href={readmeUrl(lang)} target="_blank" rel="noopener noreferrer">{t.notes.readme} →</a></p>
      </div>
    </details>

    {/* 1. How much is there? */}
    <section class="dsection" id="supply" aria-labelledby="supply-title">
      <p class="eyebrow-line">{t.sections.supply.eyebrow}</p>
      <h2 id="supply-title">{t.sections.supply.title}</h2>
      <StatCards items={supplyStats} chainLabel={chainLabels} name={t.sections.supply.title} />
      <ChartBlock id="supply" title={t.charts.supply.title} titleTemplate={t.charts.supply.title} aid={t.charts.supply.aid} noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading} />
      <ChartBlock id="mintBurn" title={resolveBucket(t.charts.mintBurn.title)} titleTemplate={t.charts.mintBurn.title} aid={t.charts.mintBurn.aid} noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading} />
      <details class="disclosure monthly">
        <summary>{interpolate(t.monthly.summary, { first: formatMonthShort(allMonths[0], lang), last: formatMonthShort(allMonths.at(-1), lang) })}</summary>
        <div class="table-scroll" role="region" tabindex="0" aria-label={t.monthly.caption}>
          <table class="tbl">
            <caption class="visually-hidden">{t.monthly.caption}</caption>
            <thead>
              <tr>
                <th scope="col">{t.columns.chain}</th><th scope="col">{t.columns.period}</th><th scope="col">{t.columns.supply}</th>
                <th scope="col">{t.columns.minted}</th><th scope="col">{t.columns.burned}</th><th scope="col">{t.columns.transfers}</th><th scope="col">{t.columns.gross}</th>
              </tr>
            </thead>
            <tbody>
              {monthlyRows.map((r) => (
                <tr data-chains={r.chain}>
                  <th scope="row">{chainLabel(r.chain)}</th><td>{r.month}</td>
                  <td class="num">{r.supply}</td><td class="num">{r.minted}</td><td class="num">{r.burned}</td><td class="num">{r.transfers}</td><td class="num">{r.gross}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </section>

    {/* 2. How much moves? */}
    <section class="dsection" id="move" aria-labelledby="move-title">
      <p class="eyebrow-line">{t.sections.move.eyebrow}</p>
      <h2 id="move-title">{t.sections.move.title}</h2>
      <div class="chart-row">
        <ChartBlock id="flows" title={t.charts.flows.title} titleTemplate={t.charts.flows.title} stat="flows" noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading}>
          <Fragment slot="stat">
            {flows.filter((f) => f.turnover !== null).map((f) => (
              <p class="flow-stat"><strong>{times(f.turnover as number)}</strong> <span>{t.charts.flows.turnover} · {f.label}</span></p>
            ))}
          </Fragment>
        </ChartBlock>
        <ChartBlock id="rate" title={t.charts.rate.title} titleTemplate={t.charts.rate.title} aid={t.charts.rate.aid} noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading} />
      </div>
      <ChartBlock id="transfers" title={resolveBucket(t.charts.transfers.title)} titleTemplate={t.charts.transfers.title} aid={t.charts.transfers.aid} noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading} />
      <ChartBlock id="volume" title={resolveBucket(t.charts.volume.title)} titleTemplate={t.charts.volume.title} aid={t.charts.volume.aid} noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading} />
      <ChartBlock id="calendar" title={t.charts.calendar.title} titleTemplate={t.charts.calendar.title} aid={t.charts.calendar.aid} noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading} />
      <ChartBlock id="daily" title={t.charts.daily.title} titleTemplate={t.charts.daily.title} noscript={t.chartUi.noscript} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading} />
    </section>

    {/* 3. Who moves it? */}
    <section class="dsection" id="who" aria-labelledby="who-title">
      <p class="eyebrow-line">{t.sections.who.eyebrow}</p>
      <h2 id="who-title">{t.sections.who.title}</h2>
      <StatCards items={whoStats} chainLabel={chainLabels} name={t.sections.who.title} />
      <div class="chart-row">
        <ChartBlock id="sizes" title={t.charts.sizes.title} titleTemplate={t.charts.sizes.title} aid={t.charts.sizes.aid} noscript={t.chartUi.noscriptTable} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading}>
          <div slot="fallback" class="table-scroll">
            <table class="tbl">
              <caption class="visually-hidden">{t.charts.sizes.title}</caption>
              <thead>
                <tr><th scope="col">{t.columns.bucket}</th>{keys.map((k) => <th scope="col" class="num">{chainLabel(k)} · {t.columns.transfers}</th>)}</tr>
              </thead>
              <tbody>
                {sizeRows.map((r) => (
                  <tr><th scope="row">{r.label}</th>{r.counts.map((c) => <td class="num">{c}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </ChartBlock>
        <ChartBlock id="holders" title={t.charts.holders.title} titleTemplate={t.charts.holders.title} aid={t.charts.holders.aid} noscript={t.chartUi.noscriptTable} viewTable={t.chartUi.viewTable} loading={t.chartUi.loading}>
          <div slot="fallback" class="table-scroll">
            <table class="tbl mixed">
              <caption class="visually-hidden">{t.charts.holders.title}</caption>
              <thead>
                <tr><th scope="col">{t.columns.chain}</th><th scope="col">{t.columns.holder}</th><th scope="col" class="num">{t.columns.supply}</th><th scope="col" class="num">{t.columns.share}</th></tr>
              </thead>
              <tbody>
                {topRows.map((h) => (
                  <tr>
                    <th scope="row">{chainLabel(h.chain)} · {h.rank}</th>
                    <td><a class="addr" href={explorerAddressUrl(h.chain, h.address)} title={h.address} target="_blank" rel="noopener noreferrer">{middleEllipsis(h.address, 6, 4)}</a></td>
                    <td class="num">{amountFull(h.balance, 'copm', lang)}</td>
                    <td class="num">{pct(h.share)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </ChartBlock>
      </div>

      <h3 class="sub">{t.who.largest}</h3>
      <LargestTable rows={largest.slice(0, LARGEST_VISIBLE)} lang={lang} unit={state.unit} t={t} chainLabel={chainLabels} slot="head" caption={t.who.largest} />
      <details class="disclosure" data-largest-more hidden={largest.length <= LARGEST_VISIBLE}>
        <summary data-largest-summary>{interpolate(t.who.largestMore, { count: Math.max(0, largest.length - LARGEST_VISIBLE) })}</summary>
        <LargestTable rows={largest.slice(LARGEST_VISIBLE)} lang={lang} unit={state.unit} t={t} chainLabel={chainLabels} slot="rest" caption={t.who.largest} />
      </details>

      <details class="disclosure">
        <summary>{interpolate(t.who.buckets, { count: holderBuckets[0].buckets.length })}</summary>
        <div class="table-scroll" role="region" tabindex="0" aria-label={t.who.bucketsCaption}>
          <table class="tbl">
            <caption class="visually-hidden">{t.who.bucketsCaption}</caption>
            <thead><tr><th scope="col">{t.columns.chain} · {t.columns.bucket}</th><th scope="col">{t.columns.holders}</th><th scope="col">{t.columns.share}</th></tr></thead>
            <tbody>
              {holderBuckets.flatMap((c) =>
                c.buckets.map((b: any) => (
                  <tr data-chains={c.key}>
                    <th scope="row">{chainLabel(c.key)} · {b.label}</th>
                    <td class="num">{formatInt(b.holders, lang)}</td>
                    <td class="num">{pct((b.copm / c.total) * 100, 2)}</td>
                  </tr>
                )),
              )}
            </tbody>
          </table>
        </div>
      </details>
      <p class="csv-links" data-csv>
        {keys.map((k) => (
          <a data-chains={k} href={holdersCsvUrl(k)} target="_blank" rel="noopener noreferrer">{t.who.csv} · {chainLabel(k)}</a>
        ))}
      </p>
    </section>

    {/* 4. Who controls it? */}
    <section class="dsection" id="control" aria-labelledby="control-title">
      <p class="eyebrow-line">{t.sections.control.eyebrow}</p>
      <h2 id="control-title">{t.sections.control.title}</h2>
      <StatCards items={controlStats} chainLabel={chainLabels} name={t.sections.control.title} cls="quad" />

      {keys.map((k) => {
        const g = dash(k).governance;
        const roles = roleEntries(k);
        return (
          <details class="disclosure" data-chains={k}>
            <summary>{interpolate(t.control.admin, { chain: chainLabel(k), roles: roles.filter(([, m]) => m.length > 0).length, events: g.events.length })}</summary>
            <div class="disclosure-body">
              <p class="small">{t.control.implementation}: <a class="addr" href={explorerAddressUrl(k, g.implementation)} title={g.implementation} target="_blank" rel="noopener noreferrer">{middleEllipsis(g.implementation, 6, 4)}</a></p>
              <div class="table-scroll" role="region" tabindex="0" aria-label={t.control.rolesCaption}>
                <table class="tbl mixed roles">
                  <caption class="visually-hidden">{t.control.rolesCaption}</caption>
                  <thead><tr><th scope="col">{t.columns.role}</th><th scope="col">{t.columns.meaning}</th><th scope="col">{t.columns.members}</th></tr></thead>
                  <tbody>
                    {roles.map(([role, members]) => (
                      <tr>
                        <th scope="row"><span class="mono">{role}</span></th>
                        <td>{roleMeaningOf(role)}</td>
                        <td>
                          {members.length === 0
                            ? '—'
                            : members.map((a) => <a class="addr" href={explorerAddressUrl(k, a)} title={a} target="_blank" rel="noopener noreferrer">{middleEllipsis(a, 6, 4)}</a>)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="table-scroll" role="region" tabindex="0" aria-label={t.control.eventsCaption}>
                <table class="tbl mixed events">
                  <caption class="visually-hidden">{t.control.eventsCaption}</caption>
                  <thead>
                    <tr><th scope="col">{t.columns.day}</th><th scope="col">{t.columns.event}</th><th scope="col">{t.columns.what}</th><th scope="col">{t.columns.detail}</th><th scope="col">{t.columns.tx}</th></tr>
                  </thead>
                  <tbody>
                    {g.events.map((e: any) => (
                      <tr>
                        <th scope="row">{formatDate(e.day, lang)}</th>
                        <td class="mono">{e.name}</td>
                        <td>{meaningOf(e.name)}</td>
                        <td class="args">
                          {Object.entries(e.args ?? {}).map(([name, value]) => (
                            <span class="arg">
                              <span class="muted">{name}</span>{' '}
                              {isAddress(value)
                                ? <a class="addr" href={explorerAddressUrl(k, value)} title={value} target="_blank" rel="noopener noreferrer">{middleEllipsis(value, 6, 4)}</a>
                                : <span class="mono">{eventArgText(e.name, name, value, lang)}</span>}
                            </span>
                          ))}
                        </td>
                        <td><a class="addr" href={explorerTxUrl(k, e.tx)} title={e.tx} target="_blank" rel="noopener noreferrer">{middleEllipsis(e.tx, 8, 6)}</a></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </details>
        );
      })}
      <p class="small"><a href={eventsDocUrl(lang)} target="_blank" rel="noopener noreferrer">{t.control.docs} →</a></p>
    </section>

    {/* 5. Can it be trusted? */}
    <section class="dsection" id="trust" aria-labelledby="trust-title">
      <p class="eyebrow-line">{t.sections.trust.eyebrow}</p>
      <h2 id="trust-title">{t.sections.trust.title}</h2>
      <ul class="cardgrid strip" aria-label={t.sections.trust.title}>
        {keys.flatMap((k) => {
          const v = data.chains[k].validation;
          const passAll = v.failed === 0;
          const supplyOk = v.checks.some((c: any) => c.id === 'supply-exact' && c.ok === true);
          const strip = [
            { icon: passAll ? 'check' : 'cross', cls: passAll ? 'pass' : 'fail', label: t.trust.tileRules, value: interpolate(t.trust.tileRulesValue, { passed: formatInt(v.passed, lang), total: formatInt(v.checks.length, lang) }) },
            { icon: 'block', cls: '', label: t.trust.tileBlock, value: formatInt(dash(k).checkpoint.block, lang) },
            { icon: 'clock', cls: '', label: t.trust.tileScan, value: utcDateTime(dash(k).checkpoint.time) },
            { icon: supplyOk ? 'scale' : 'cross', cls: supplyOk ? 'pass' : 'fail', label: t.trust.tileSupply, value: supplyOk ? t.trust.supplyOk : t.trust.supplyFail },
          ];
          return strip.map((tile) => (
            <li class={`stile ${tile.cls}`} data-chains={k}>
              <StatusIcon name={tile.icon as 'check'} />
              <div>
                <p class="v">{tile.value}</p>
                <p class="k"><span class={`dot ${k}`} aria-hidden="true"></span><span>{tile.label} · {chainLabel(k)}</span></p>
              </div>
            </li>
          ));
        })}
      </ul>

      {keys.map((k) => {
        const v = data.chains[k].validation;
        return (
          <details class="disclosure" data-chains={k}>
            <summary>{interpolate(t.trust.rulesSummary, { chain: chainLabel(k), passed: formatInt(v.passed, lang), total: formatInt(v.checks.length, lang), block: formatInt(dash(k).checkpoint.block, lang) })}</summary>
            <div class="table-scroll" role="region" tabindex="0" aria-label={t.trust.rulesCaption}>
              <table class="tbl mixed rules">
                <caption class="visually-hidden">{t.trust.rulesCaption}</caption>
                <thead><tr><th scope="col">{t.columns.status}</th><th scope="col">{t.columns.rule}</th><th scope="col">{t.columns.detail}</th></tr></thead>
                <tbody>
                  {v.checks.map((c: any) => (
                    <tr>
                      <th scope="row">
                        <span class={`status ${c.ok ? 'pass' : 'fail'}`}>
                          <span aria-hidden="true">{c.ok ? '✓' : '✕'}</span> {c.ok ? t.trust.pass : t.trust.fail}
                        </span>
                      </th>
                      <td>
                        <span>{ruleLabelOf(c.id)}</span>
                        <span class="muted rule-id"> <span class="mono">{c.id}</span></span>
                      </td>
                      <td class="mono detail">{c.detail}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        );
      })}
    </section>
  </main>

  <SiteFooter navLabel={t.footer.repo} links={footerLinks} credit={t.footer.credit} />

  <script id="dashboard-data" type="application/json" set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')} />
  <script>
    import { mountDashboard } from './client.js';
    mountDashboard(document);
  </script>
</Base>
