---
import '../styles/global.css';
import LangSwitch from '../components/LangSwitch.astro';
import SiteNav from '../components/SiteNav.astro';
import { dictionaries } from '../i18n/index.js';
import { alternatesFor, canonicalUrl, languageSwitch, navigation } from '../lib/routes.js';

interface Props {
  lang: 'es' | 'en';
  /** Key of the route table: decides canonical, hreflang, language switch and navigation. */
  page: 'dashboard' | 'analysis';
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;

const dict = dictionaries[lang];
const site = Astro.site ?? new URL('https://copm.juansac.dev');
const canonical = canonicalUrl(page, lang, site);
const alternates = alternatesFor(page, site);
const switchItems = languageSwitch(page, lang);
const navItems = navigation(lang, page).map((item) => ({ ...item, label: dict.nav[item.key] }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  </head>
  <body>
    <div id="progress" role="presentation"></div>
    <SiteNav label={dict.a11y.mainNavLabel} items={navItems} />
    <LangSwitch label={dict.a11y.langLabel} items={switchItems} />
    <slot />

    <script>
      // barra de progreso de lectura
      const bar = document.getElementById('progress')!;
      function update() {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
      }
      addEventListener('scroll', update, { passive: true });
      update();

      // aparición progresiva de capítulos
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              obs.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
