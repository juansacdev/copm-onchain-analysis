---
interface Props {
  eyebrow: string;
  stats: { value: string; label: string }[];
  scrollHint: string;
}

const { eyebrow, stats, scrollHint } = Astro.props;
---

<section class="hero">
  <p class="eyebrow"><span class="mark polygon" aria-hidden="true"></span>Polygon · Celo<span class="mark celo" aria-hidden="true"></span>{eyebrow}</p>
  <h1><slot name="title" /></h1>
  <p class="sub"><slot name="sub" /></p>
  <dl class="stat-tiles">
    {stats.map((stat) => (
      <div class="stat-tile">
        <dt class="k">{stat.label}</dt>
        <dd class="v">{stat.value}</dd>
      </div>
    ))}
  </dl>
  <span class="scroll-hint" aria-hidden="true">{scrollHint}</span>
</section>
