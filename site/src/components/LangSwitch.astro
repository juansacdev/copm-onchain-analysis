---
interface Props {
  label: string;
  items: { lang: string; href: string; current: boolean }[];
}

const { label, items } = Astro.props;
---

<nav class="langswitch" aria-label={label}>
  {items.map((item) => (
    <a href={item.href} aria-current={item.current ? 'true' : undefined} lang={item.lang}>{item.lang.toUpperCase()}</a>
  ))}
</nav>
